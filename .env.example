# Browser-safe Supabase values only. Never put a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key supported as a fallback; leave blank when using a publishable key.
VITE_SUPABASE_ANON_KEY=
