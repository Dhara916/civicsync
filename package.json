{
  "name": "civicsync-final",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-env.mjs --allow-unconfigured && tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.tests.json && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "check": "npm run test && npm run build",
    "check:env": "node scripts/check-env.mjs",
    "check:source": "node scripts/source-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "pg": "^8.16.0"
  }
}
